##############################################################################
# Copy to .env and fill in. NEVER commit the real .env — it is git-ignored.
# Generate a secret key with:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
##############################################################################

# --- Core -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Move the admin off the default path in production, e.g. ops-8f2c1b/
DJANGO_ADMIN_URL=admin/
LOG_LEVEL=INFO
# Set to DEBUG to see every SQL statement (local debugging only).
SQL_LOG_LEVEL=WARNING
TIME_ZONE=UTC

# --- PostgreSQL -------------------------------------------------------------
# With docker compose, POSTGRES_HOST must be the service name: db
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Seconds to keep a connection open between requests. 0 = reconnect every
# request (slow). Keep below the Postgres idle timeout.
POSTGRES_CONN_MAX_AGE=60

# --- API --------------------------------------------------------------------
API_TITLE=Application API
API_VERSION=1.0.0
API_PAGE_SIZE=25

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Optional: a signing key separate from SECRET_KEY, so rotating one does not
# invalidate the other.
# JWT_SIGNING_KEY=

# --- Passwords --------------------------------------------------------------
PASSWORD_MIN_LENGTH=10
# Reset-link lifetime in seconds (3600 = 1 hour).
PASSWORD_RESET_TIMEOUT=3600

# --- Throttling (DRF rate strings) ------------------------------------------
THROTTLE_AUTH=10/min
THROTTLE_REGISTER=20/hour
THROTTLE_PASSWORD_RESET=5/hour

# --- CORS / CSRF ------------------------------------------------------------
# The front-end origins, comma separated. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# --- Email ------------------------------------------------------------------
# Default backend PRINTS emails to the server log; nothing is actually sent
# until you switch to SMTP and supply credentials below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
# The FRONT-END page that collects the new password. The API emails a link to
# this URL with ?uid=...&token=... appended.
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# --- Security (defaults follow DJANGO_DEBUG; override only if needed) -------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# USE_X_FORWARDED_PROTO=True

# --- External integrations --------------------------------------------------
EXCHANGE_RATES_BASE_URL=https://open.er-api.com/v6
EXCHANGE_RATES_API_KEY=
EXCHANGE_RATES_TIMEOUT=10
HTTP_CLIENT_MAX_RETRIES=2
HTTP_CLIENT_BACKOFF=0.5

# --- Cache (phase two) ------------------------------------------------------
# Set to enable Redis; leave blank for in-process caching.
# REDIS_URL=redis://redis:6379/0
